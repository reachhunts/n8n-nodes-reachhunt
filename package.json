{
	"name": "@reachhunt/n8n-nodes-reachhunt",
	"version": "0.1.0",
	"description": "n8n nodes for ReachHunt: run DM outreach on X and LinkedIn from your workflows",
	"license": "MIT",
	"homepage": "https://reachhunt.ai",
	"keywords": [
		"n8n-community-node-package",
		"reachhunt",
		"linkedin",
		"x",
		"twitter",
		"outreach",
		"dm"
	],
	"author": {
		"name": "ReachHunt",
		"email": "support@reachhunt.ai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reachhunts/n8n-nodes-reachhunt.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "vitest run",
		"generate": "node scripts/generate.mjs",
		"sync:spec": "node scripts/sync-spec.mjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ReachHuntApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ReachHunt/ReachHunt.node.js",
			"dist/nodes/ReachHuntTrigger/ReachHuntTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.51.3",
		"@types/node": "24.19.1",
		"eslint": "9.32.0",
		"n8n-workflow": "2.42.2",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
